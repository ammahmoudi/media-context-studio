{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run local video context service",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"video_context.cli",
				"serve"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build video context dashboard",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"--dir",
				"web",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		}
	]
}