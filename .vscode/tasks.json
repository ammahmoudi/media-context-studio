{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run production GPU worker",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": ["scripts/with_stack.py", "worker", "--queues", "gpu"],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run local video context service",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"-m",
				"video_context.cli",
				"serve"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build video context dashboard",
			"type": "shell",
			"command": "pnpm",
			"args": [
				"--dir",
				"web",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Run GPU worker for Docker stack",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"scripts/with_stack.py",
				"worker",
				"--queues",
				"gpu"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
