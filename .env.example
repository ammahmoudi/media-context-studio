# Copy to .env and replace every credential. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
S3_ACCESS_KEY=replace-access-key
S3_SECRET_KEY=replace-with-a-long-random-secret
VIDEO_CONTEXT_API_KEY=replace-with-a-long-random-api-key
VIDEO_CONTEXT_HTTP_PORT=18765
VIDEO_CONTEXT_S3_PORT=19020
VIDEO_CONTEXT_CONSOLE_PORT=19021
VIDEO_CONTEXT_DB_PORT=55433
VIDEO_CONTEXT_QUEUE_CAPACITY=32
VIDEO_CONTEXT_ALLOWED_HOSTS=127.0.0.1,localhost,api
VIDEO_CONTEXT_WHISPER_MODEL=base
# Optional native GPU overrides; Docker's CPU profile does not override config.local.json.
# VIDEO_CONTEXT_NATIVE_WHISPER_MODEL=large-v3-turbo
# VIDEO_CONTEXT_NATIVE_WHISPER_DEVICE=cuda
# VIDEO_CONTEXT_NATIVE_WHISPER_COMPUTE=int8_float16
# Native temporary work may use a different drive; durable PostgreSQL/S3 data is unchanged.
# VIDEO_CONTEXT_NATIVE_DATA=D:/video-context-scratch
VIDEO_CONTEXT_CPU_THREADS=4
# Memory units below are MiB unless using a Compose suffix (m/g).
VIDEO_CONTEXT_AUDIO_CHUNK_SECONDS=120
VIDEO_CONTEXT_START_FREE_RAM_MB=1536
VIDEO_CONTEXT_MIN_FREE_RAM_MB=384
VIDEO_CONTEXT_MIN_FREE_DISK_MB=2048
VIDEO_CONTEXT_WORKER_MAX_RAM_MB=3584
VIDEO_CONTEXT_NATIVE_MEMORY_LIMIT_MB=6144
VIDEO_CONTEXT_START_FREE_VRAM_MB=3072
VIDEO_CONTEXT_WARM_FREE_VRAM_MB=768
VIDEO_CONTEXT_MIN_FREE_VRAM_MB=256
VIDEO_CONTEXT_MAX_DURATION_SECONDS=21600
VIDEO_CONTEXT_MAX_VIDEO_PIXELS=8294400
VIDEO_CONTEXT_MAX_CONTEXT_MB=16
VIDEO_CONTEXT_MAX_SHOTS=5000
# Shared resource domains MUST match for replicas using the same host or GPU.
VIDEO_CONTEXT_MAX_PARALLEL=1
VIDEO_CONTEXT_CPU_RESOURCE_DOMAIN=local-stack:cpu
VIDEO_CONTEXT_GPU_RESOURCE_DOMAIN=local-stack:gpu:0
VIDEO_CONTEXT_API_MEMORY=512m
VIDEO_CONTEXT_POSTGRES_MEMORY=512m
VIDEO_CONTEXT_STORAGE_MEMORY=1g
VIDEO_CONTEXT_WORKER_MEMORY=4g
VIDEO_CONTEXT_GPU_WORKER_MEMORY=4g
# Optional: reuse an existing model cache on a Windows laptop.
# VIDEO_CONTEXT_MODELS_VOLUME=./.models
## Maximum uncompressed bytes selected for one streamed ZIP/TAR.GZ download (16 GiB).
VIDEO_CONTEXT_MAX_EXPORT_BYTES=17179869184
