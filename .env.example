# Copy to .env and replace every credential. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-password
S3_ACCESS_KEY=replace-access-key
S3_SECRET_KEY=replace-with-a-long-random-secret
VIDEO_CONTEXT_API_KEY=replace-with-a-long-random-api-key
VIDEO_CONTEXT_HTTP_PORT=18765
VIDEO_CONTEXT_S3_PORT=19020
VIDEO_CONTEXT_CONSOLE_PORT=19021
VIDEO_CONTEXT_DB_PORT=55433
VIDEO_CONTEXT_QUEUE_CAPACITY=32
VIDEO_CONTEXT_ALLOWED_HOSTS=127.0.0.1,localhost,api
VIDEO_CONTEXT_WHISPER_MODEL=base
VIDEO_CONTEXT_CPU_THREADS=4
# Optional: reuse an existing model cache on a Windows laptop.
# VIDEO_CONTEXT_MODELS_VOLUME=./.models
